{
  "version": 2,
  "builds": [
    {
      "src": "server/server.js",
      "use": "@vercel/node"
    },
    {
      "src": "client/public/**/*",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/server/server.js"
    },
    {
      "src": "/(.*\\.(css|js|png|jpg|jpeg|gif|ico|json|txt))",
      "dest": "/client/public/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/client/public/index.html"
    }
  ],
  "env": {
    "NODE_ENV": "production",
    "MONGODB_URI": "@cloudmon_mongodb_uri",
    "JWT_SECRET": "@cloudmon_jwt_secret",
    "JWT_EXPIRE": "30d",
    "CLIENT_URL": "https://your-domain.vercel.app",
    "CLOUDMON_URL": "https://cloudmon.com",
    "UPLOAD_LIMIT": "10485760",
    "TELEGRAM_SUPPORT_URL": "https://t.me/cloudmon_support",
    "TELEGRAM_PREMIUM_URL": "https://t.me/cloudmon_premium"
  }
}